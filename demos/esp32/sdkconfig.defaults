CONFIG_IDF_TARGET="esp32s3"
# ESP32-S3-N16R8 (e.g. DevKitC-1 N16R8): 16 MB quad flash, 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The parsed weights (~1 MB) live in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Weights are streamed every frame: give the data cache its largest setting.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The engine reports errors as C++ exceptions; without this they abort.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# Logs go to the native USB port (USB-Serial/JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
